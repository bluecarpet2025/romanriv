NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-1269876ce2c64008b6bf303dfb05aa11.r2.dev

# Server-only. Never prefix these with NEXT_PUBLIC_.
# Create an R2 Object Read & Write token scoped to romanriv-media.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=romanriv-media

# Server-only food image analysis. No live tagging occurs without key + model.
FOOD_TAGGING_PROVIDER=openai
FOOD_TAGGING_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# For another provider with vision + strict Chat Completions JSON-schema support:
# FOOD_TAGGING_PROVIDER=openai-compatible
# FOOD_TAGGING_BASE_URL=https://your-provider.example/v1
# FOOD_TAGGING_API_KEY=
